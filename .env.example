# =====================================================================
# TATKAL PROXY - ENVIRONMENT CONFIGURATION
# =====================================================================

# Telegram Bot Configuration
# Obtain your Bot Token from @BotFather on Telegram
BOT_TOKEN=1234567890:ABCDefghIJKlmNoPQRsTUVwxyZ

# Numeric Telegram User IDs of Admins (comma-separated, get from @userinfobot)
ADMIN_IDS=123456789,987654321

# UPI Payment Details for Manual UPI Mode
UPI_ID=tatkalproxy@okaxis
UPI_NAME=Tatkal Proxy Store

# Proxy Credential Encryption Key (Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=dGhpcy1pcy1hLXNhbXBsZS0zMi1ieXRlLWtleS1mb3ItZGV2MQ==

# Database Connection URL
# Local development uses SQLite:
DATABASE_URL=sqlite:///tatkalproxy.db
# Production uses PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://tatkal_user:strong_password@localhost:5432/tatkal_proxy

# Environment Mode: 'development' (uses Polling) or 'production' (uses Webhooks)
ENVIRONMENT=development

# Webhook & API Settings (FastAPI server)
WEBHOOK_HOST=https://yourdomain.com
WEBHOOK_PORT=8000
WEBHOOK_SECRET=your_telegram_webhook_secret_token
PAYMENT_GATEWAY_WEBHOOK_SECRET=your_payment_gateway_hmac_secret_key

# Logging Configuration
LOG_LEVEL=INFO
